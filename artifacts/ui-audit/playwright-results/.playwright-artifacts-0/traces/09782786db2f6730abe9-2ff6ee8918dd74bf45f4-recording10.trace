{"type":"before","callId":"mpie@711","startTime":44778.191,"class":"Frame","method":"evalOnSelectorAll","params":{"selector":"input, select, textarea, button, table","expression":"elements => {\n    return elements.flatMap(element => {\n      const bounds = element.getBoundingClientRect();\n      if (bounds.width === 0 || bounds.height === 0) {\n        return [];\n      }\n      const insideScrollableRegion = element.closest('.overflow-x-auto, [data-scroll-container]');\n      if (insideScrollableRegion) {\n        return [];\n      }\n      return bounds.left < -1 || bounds.right > window.innerWidth + 1 ? [element.tagName.toLowerCase() + (element.id ? `#${element.id}` : '')] : [];\n    });\n  }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}}}
